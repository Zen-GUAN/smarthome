# 复制为 .env 并填入真实值(.env 已被 .gitignore 排除, 严禁提交)
# UIOT/保利智家 设备控制平台凭据
# 凭据(app_key/secret/token 接口)需通过你与开发商或物业的既有协议获取;
# 该平台对个人开发者开放受限, 本项目不包含凭据获取方法, 仅提供对接实现。
UIOT_APP_KEY=
UIOT_APP_SECRET=
UIOT_HOME_SN=
UIOT_ACCOUNT=
UIOT_PASSWORD=
UIOT_GATEWAY=https://openapi.unisiot.com/gateway
UIOT_OAUTH_TOKEN_URL=

# 巴法云 (控制台获取, 32位hex; 同时是 MQTT client_id)
BEMFA_PRIVATE_KEY=

# Home Assistant 长效访问令牌 (用户-安全-长效访问令牌 创建)
HASS_TOKEN=
HA_URL=http://homeassistant.local:8123
